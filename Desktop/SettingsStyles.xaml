<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SettingsTabItem" TargetType="TabItem">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="ItemSurface" Margin="0,0,2,2" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Surface}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Soft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsTabs" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel LastChildFill="True" KeyboardNavigation.TabNavigation="Local">
                        <Border x:Name="Navigation" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="True">
                                <ContentPresenter Content="{TemplateBinding Tag}" DockPanel.Dock="Right"
                                                  VerticalAlignment="Top"/>
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"/>
                            </DockPanel>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          KeyboardNavigation.TabIndex="2"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="Navigation" Property="DockPanel.Dock" Value="Left"/>
                            <Setter TargetName="Navigation" Property="Width" Value="121"/>
                            <Setter TargetName="Navigation" Property="Padding" Value="9,16,7,12"/>
                            <Setter TargetName="Navigation" Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter TargetName="Navigation" Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Setter TargetName="Navigation" Property="Background" Value="{DynamicResource Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
